def ext_link(url: str, text: str, event: str = 'golf_club_click') -> str:
    return f'<a data-analytics-event="{event}" href="{url}" rel="noopener noreferrer nofollow" target="_blank">{text}</a>'


def main_en() -> str:
    return f'''<main>
<section class="hero hero-season"><div class="shell"><div class="hero-content"><span class="eyebrow">Private golf holidays on Spain’s Atlantic coast</span><h1>Play golf. Live Andalusia.</h1><p class="lead">A private five-bedroom home for groups who want more than a round of golf: official access to Golf Nuevo Portil is under one minute away on foot, with the Atlantic coast, El Rompido and the eastern Algarve within easy reach.</p><div class="hero-actions"><a class="button primary" data-analytics-event="booking_click" href="{BOOKING['en']}">Check dates and prices →</a><a class="button outline-light" href="{HOME['en']}">See the main villa site</a></div></div></div><div class="hero-facts"><div class="hero-fact"><strong>5</strong><span>bedrooms</span></div><div class="hero-fact"><strong>10</strong><span>guests maximum</span></div><div class="hero-fact"><strong>6</strong><span>adults maximum</span></div><div class="hero-fact"><strong>Private</strong><span>fenced pool</span></div></div></section>
<section class="stat-strip"><div class="shell stats"><div class="stat"><strong>Under 1 minute</strong><span>official golf access on foot</span></div><div class="stat"><strong>From 4 nights</strong><span>on selected off-season dates</span></div><div class=
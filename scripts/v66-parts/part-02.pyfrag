        text = replace_present(text, 'Explore golf and off-season stays →', 'Explore Atlantic Golf House and off-season stays →')
    else:
        old = 'En primavera y otoño, la villa se convierte en una base privada para 4–6 golfistas adultos o grupos mixtos: golf, costa, comidas compartidas y fechas más flexibles fuera del verano.'
        new = 'En primavera y otoño, Atlantic Golf House at Villa Almale se convierte en una base privada para 4–6 golfistas adultos o grupos mixtos. El acceso peatonal oficial al Golf Nuevo Portil está a menos de un minuto a pie, con costa, comidas compartidas y fechas más flexibles fuera del verano.'
        text = replace_or_assert(text, old, new, 'Atlantic Golf House at Villa Almale se convierte', 'ES home golf')
        text = replace_present(text, 'Descubrir golf y temporada baja →', 'Descubrir Atlantic Golf House y las estancias fuera de temporada →')

    shared = {
        'Un parcours 18 trous, par 71, intégré à la pinède et praticable confortablement à pied.': 'L’accès piéton officiel au Golf Nuevo Portil se trouve à moins d’une minute à pied. Le parcours 18 trous, par 71, est intégré à la pinède.',
        'An 18-hole, par-71 course set among pine trees and comfortably walkable.': 'The official pedestrian access to Golf Nuevo Portil is under one minute away on foot. The 18-hole, par-71 course is set among pine trees.',
        'Un recorrido de 18 hoyos, par 71, integrado entre pinos y cómodo para recorrer a pie.': 'El acceso peatonal oficial al Golf Nuevo Portil está a menos de un minuto a pie. El recorrido de 18 hoyos, par 71, discurre entre pinares.',
        'Nuevo Portil golf course borders the residential area; El Rompido is also close.': 'The official pedestrian access to Golf Nuevo Portil is under one minute away on foot; El Rompido is also close.',
        'El campo de Nuevo Portil bordea la zona residencial; El Rompido también está cerca.': 'El acceso peatonal oficial al Golf Nuevo Portil está a menos de un minuto a pie; El Rompido también está cerca.',
    }
    for old, new in shared.items():
        text = replace_present(text, old, new)
    return text


def patch_target(text: str, lang: str) -> str:
    changes = {
        'fr': (
            'La plage de la Ría del Río Piedras se trouve à environ 10–15 minutes à pied. Le golf de Nuevo Portil borde le quartier résidentiel et El Rompido est tout proche.',
            'La plage de la Ría del Río Piedras se trouve à environ 10–15 minutes à pied. L’accès piéton officiel au Golf Nuevo Portil est à moins d’une minute à pied de la villa, et El Rompido est tout proche.',
            '<div class="fact">Golf à proximité</div>', '<div class="fact">Accès golf &lt; 1 min à pied</div>',
        ),
        'en': (
            'Ría del Río Piedras beach is about a 10–15 minute walk away. Nuevo Portil golf course borders the residential area and El Rompido is nearby.',
            'Ría del Río Piedras beach is about a 10–15 minute walk away. The official pedestrian access to Golf Nuevo Portil is under one minute away on foot, and El Rompido is nearby.',
            '<div class="fact">Golf nearby</div>', '<div class="fact">Golf access &lt; 1 min walk</div>',
        ),
        'es': (
            'La playa de la Ría del Río Piedras está a unos 10–15 minutos a pie. El campo de golf de Nuevo Portil linda con la zona residencial y El Rompido está muy cerca.',
            'La playa de la Ría del Río Piedras está a unos 10–15 minutos a pie. El acceso peatonal oficial al Golf Nuevo Portil está a menos de un minuto a pie de la villa, y El Rompido está muy cerca.',
            '<div class="fact">Golf cercano</div>', '<div class="fact">Acceso al golf &lt; 1 min a pie</div>',
        ),
    }
    old, new, old_fact, new_fact = changes[lang]
    text = replace_present(text, old, new)
    text = replace_present(text, old_fact, new_fact)
    return text



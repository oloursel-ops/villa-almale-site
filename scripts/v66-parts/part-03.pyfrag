    text = set_title(text, cfg['title'])
    for attr, key in [('name', 'description'), ('property', 'og:title'), ('property', 'og:description'), ('name', 'twitter:title'), ('name', 'twitter:description')]:
        text = set_meta(text, attr, key, cfg['title'] if 'title' in key else cfg['desc'])
    text = replace_or_assert(text, cfg['old_hero'], cfg['hero'], cfg['hero_marker'], f'{lang} golf hero')
    text = replace_present(text, cfg['old_stat'], cfg['stat'])
    if 'class="notice-box golf-access"' not in text:
        if '<div class="course-grid">' not in text:
            raise RuntimeError(f'{lang}: course grid missing')
        text = text.replace('<div class="course-grid">', cfg['notice'] + '<div class="course-grid">', 1)
    if cfg['question'] not in text:
        if cfg['faq_anchor'] not in text:
            raise RuntimeError(f'{lang}: FAQ anchor missing')
        text = text.replace(cfg['faq_anchor'], cfg['question'] + cfg['faq_anchor'], 1)
    return text


def update_json_ld(text: str, lang: str) -> str:
    count = 0
    def walk(node: Any) -> None:
        if isinstance(node, dict):
            node_type = node.get('@type')
            types = {node_type} if isinstance(node_type, str) else set(node_type or [])
            if 'WebPage' in types:
                node['dateModified'] = DATE
            if 'Accommodation' in types:
                amenities = node.setdefault('amenityFeature', [])
                names = {x.get('name') for x in amenities if isinstance(x, dict)}
                for name in ('Three portable air-conditioning units in selected rooms', 'Ceiling fans in two twin bedrooms', 'Official Golf Nuevo Portil pedestrian access under one minute away'):
                    if name not in names:
                        amenities.append({'@type': 'LocationFeatureSpecification', 'name': name, 'value': True})
                same_as = node.setdefault('sameAs', [])
                for url in (AIRBNB, VRBO):
                    if url not in same_as:
                        same_as.append(url)
            if 'FAQPage' in types:
                for q in node.get('mainEntity', []):
                    if not isinstance(q, dict):
                        continue
                    name = str(q.get('name', '')).lower()
                    if any(term in name for term in ('climatisation', 'air conditioning', 'aire acondicionado')):
                        q.setdefault('acceptedAnswer', {'@type': 'Answer'})['text'] = AC[lang]
            for value in node.values():
                walk(value)
        elif isinstance(node, list):
            for value in node:
                walk(value)
    def repl(match: re.Match[str]) -> str:
        nonlocal count
        payload = json.loads(match.group(1).strip())
        walk(payload)
        count += 1
        return '<script type="application/ld+json">' + json.dumps(payload, ensure_ascii=False, separators=(',', ':')) + '</script>'
    text = re.sub(r'<script\b[^>]*type=["\']application/ld\+json["\'][^>]*>(.*?)</script>', repl, text, flags=re.I | re.S)
    if count < 1:
        raise RuntimeError('JSON-LD missing')
    return text


